# 主站站点配置 —— Vite 环境变量（所有模式共用的默认值）
#
# 说明：
# - 仅 VITE_ 前缀的变量会暴露给前端代码（import.meta.env.VITE_*）
# - 本文件随仓库提交，存放站点级默认值；本地个性化覆盖请写 .env.local（已被 gitignore 的 *.local 规则忽略）
# - 环境变量在构建期静态替换，改完需重启 vite dev / 重新 npm run build 才生效
# - 代码统一经 src/config/mc-config.js 读取，组件里不要直接读 import.meta.env

# ---- 游戏服务器（监控展示） ----
# 监控接口 /monitor/server-info/{id} 的路由参数，对应后端 SERVERS 注册表的主服务器 id
VITE_SERVER_ID=1
# 支持的游戏版本（首页展示文案）
VITE_JAVA_VERSIONS=1.18 - 1.21.11
VITE_BEDROCK_VERSIONS=1.18.100 - 1.21.200

# ---- QQ 群 ----
VITE_QQ_GROUP_ID=942235691
VITE_QQ_GROUP_CODE_IMG_URL=https://img.fastmirror.net/s/2025/11/30/692bdccb7daa6.jpg
VITE_QQ_GROUP_INVITE_LINK_URL=https://qm.qq.com/q/8jQDx8OCOY

# ---- 后台管理入口 ----
# 相对路径或绝对路径，默认 /admin（独立后台管理前端）
VITE_ADMIN_URL=/admin/

# ---- Wiki 入口 ----
# 相对路径或绝对路径，默认 /wiki/（VitePress 构建产物，生产由 Nginx 挂载在 /wiki/）
VITE_WIKI_URL=/wiki/

# ---- 智能客服 ----
# 前端侧总开关（后端另有 /kb/info enabled 开关，两级都开才渲染悬浮球）
VITE_CHAT_WIDGET_ENABLED=true
VITE_CHAT_WIDGET_TITLE=星驿助手
VITE_CHAT_WIDGET_GREETING=你好，我是星穹旅驿的智能助手，可以问我进服、指令、规则相关的问题。
# 首屏示例问题，用 | 分隔
VITE_CHAT_WIDGET_FAQ=服务器地址是多少|怎么加入服务器|封禁了怎么申诉

# ---- 员工名片（/staff/:code 验证页与 /team 总览页） ----
# 服务器名称（名片与验证页展示）
VITE_SERVER_NAME=星穹旅驿
# 官方网址（验证页展示值，与后端二维码 STAFF_PUBLIC_BASE_URL 同源；不在组件内硬编码）
VITE_STAFF_OFFICIAL_URL=https://xqly.xt91tv.shop:23333
# 官方 Discord 入口（留空则验证页不展示该项）
VITE_STAFF_DISCORD_URL=
# 防伪提示（需求 §9.3，用 | 分行；名片与验证页都必须包含）
VITE_STAFF_ANTI_FRAUD_TEXT=本名片仅用于工作人员身份介绍。|工作人员不会索要你的账号密码、验证码、支付密码或远程控制权限。|如有疑问，请通过官网管理组页面核实。
