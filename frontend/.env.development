# 开发模式（npm run dev）专用配置，优先级高于 .env
# 本地 FastAPI 后端地址
VITE_BASE_API_URL=http://localhost:5000
VITE_ADMIN_URL=http://localhost:3005
# 本地 VitePress dev server（cd wiki && npm run dev，默认 :5174）
VITE_WIKI_URL=http://localhost:5174/wiki/
# ---- 智能客服（dev 默认沿用 .env，显式声明便于本地关闭调试）----
VITE_CHAT_WIDGET_ENABLED=true
