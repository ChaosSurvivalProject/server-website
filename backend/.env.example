# ── 总开关 ──────────────────────────────────────────────
KB_ENABLED=1

# ── 对话模型（OpenAI 兼容） ──────────────────────────────
KB_CHAT_BASE_URL=https://api.deepseek.com/v1
KB_CHAT_API_KEY=sk-xxxxxxxx
KB_CHAT_MODEL=deepseek-chat
# 可选：原样合并进请求体，用于开启 thinking 等厂商私有参数
KB_CHAT_EXTRA_BODY={"enable_thinking":true}
KB_MAX_OUTPUT_TOKENS=800

# ── Embedding（OpenAI 兼容） ────────────────────────────
KB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBED_API_KEY=sk-xxxxxxxx
KB_EMBED_MODEL=BAAI/bge-m3
KB_EMBED_DIM=1024

# ── 检索 ────────────────────────────────────────────────
KB_VECTOR_ENABLED=1
KB_HYBRID_ENABLED=1          # 0 = 只用向量，不走 FTS5
KB_TOP_K=5
KB_MIN_SCORE=0.35            # 低于此分视为未命中 → 直接引导话术，不调 LLM
KB_MAX_CHUNKS=2000           # 内存向量硬上限（128M 机器别调大）

# ── 输入与限流 ──────────────────────────────────────────
KB_MAX_INPUT_CHARS=300
KB_MAX_HISTORY=6
KB_RATE_LIMIT_PER_HOUR=20
KB_RATE_LIMIT_GLOBAL_PER_MIN=5
KB_RATE_LIMIT_CONCURRENT_PER_IP=1   # 0 = 关闭限流

# ── 知识源 ──────────────────────────────────────────────
KB_WIKI_DIR=../wiki                  # 相对 backend/ 或绝对路径
KB_WIKI_EXCLUDE=node_modules,.vitepress,dist
KB_TITLE=星驿助手
KB_GREETING=你好，我是星穹旅驿的智能助手，可以问我进服、指令、规则相关的问题。
KB_FALLBACK_HINT=抱歉，这个问题我暂时答不上来，你可以到 QQ 群 942235691 咨询管理员。
KB_SYSTEM_PROMPT_EXTRA=

# ── 员工名片模块 ─────────────────────────────────────────
# 二维码 URL 前缀唯一来源（后端拼接 {STAFF_PUBLIC_BASE_URL}/staff/{身份码}，无尾斜杠）。
# ⚠️ 定值：https://xqly.xt91tv.shop:23333（docs/员工名片模块需求规格.md §0.2）。
# 二维码是印刷品，协议+域名+端口+路径任一变更 = 已发出名片全量重印；改后需重启进程。
STAFF_PUBLIC_BASE_URL=https://xqly.xt91tv.shop:23333