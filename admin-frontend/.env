# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# ---- 员工名片（名片制作页） ----
# 服务器名称（名片正面顶部展示；与主站 frontend/.env 的 VITE_SERVER_NAME 保持一致）
VITE_STAFF_SERVER_NAME = 星穹旅驿
# 名片副标题（服务器名称下方的灰白小字）
VITE_STAFF_TAGLINE = 阵营对抗乱世生存 · Java / 基岩多端互通
# 官网地址（名片正面展示的固定文案——印刷品，dev 构建也要印生产地址）
VITE_STAFF_OFFICIAL_URL = https://xqly.xt91tv.shop:23333
# 名片防伪提示（需求 §9.3，用 | 分隔；与主站 VITE_STAFF_ANTI_FRAUD_TEXT 保持一致）
VITE_STAFF_ANTI_FRAUD_TEXT = 本名片仅用于工作人员身份介绍。|工作人员不会索要你的账号密码、验证码、支付密码或远程控制权限。|如有疑问，请通过官网管理组页面核实。
# 名片背面「身份核验说明」五条声明（用 | 分隔）
VITE_STAFF_CARD_BACK_DISCLAIMERS = 本名片仅用于工作人员身份介绍|不代表后台、管理或支付权限|正式工作人员不会索要账号密码|不会索取验证码或支付信息|请勿扫描来源不明的二维码
# 点击完整身份码跳转核验页的站点前缀；生产为同域部署留空即可（相对 /staff/{code}），
# 开发覆盖在 .env.development（指向主站 dev server）
VITE_STAFF_SITE_URL =
