# 构建上下文是项目根目录（根 docker-compose.yml 的 context: .），
# 用本文件把与镜像无关的大目录挡在 context 之外（node_modules/dist/.git 不参与构建）
.git
.gitignore
**/node_modules
**/dist
wiki/.vitepress/cache
wiki/.vitepress/dist
backend/data
# 含 API Key 的配置绝不进镜像（运行时由 compose 只读挂载）
backend/.env
docs
.vscode
.idea
logs
for-deploy
.zcode

# 根目录 .env 只用于 compose 插值，不进构建上下文
.env
